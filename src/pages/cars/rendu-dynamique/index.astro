---
import LayoutMenu from "../../../layouts/LayoutMenu.astro";
import cars from "../../../assets/cars.json";

const years = [...new Set(cars.map((c) => c.year))].sort();
---

<LayoutMenu>
  <h1 class="text-2xl">Voitures, rendu dynamique : années</h1>
  <ul class="list-disc ml-6">
    {
      years.map((y) => (
        <li>
          <a class="text-sky-700 underline" href={`/cars/rendu-dynamique/${y}`}>
            Année : {y}
          </a>
        </li>
      ))
    }
  </ul>
</LayoutMenu>
