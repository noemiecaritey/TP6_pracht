---
import PlotFigure from "../../../components/PlotFigure.astro";
import LayoutMenu from "../../../layouts/LayoutMenu.astro";
import * as Plot from "@observablehq/plot";
import cars from "../../../assets/cars.json";

export function getStaticPaths() {
  const years = [...new Set(cars.map((c) => c.year))];
  return years.map((y) => ({
    params: { year: String(y) },
    props: { filtered: cars.filter((c) => c.year === y) },
  }));
}

const { year } = Astro.params;
const { filtered } = Astro.props;
---

<LayoutMenu>
  <h1 class="text-2xl">Voitures de l'année {year}</h1>
  <p>{filtered.length} voiture(s)</p>
  <PlotFigure
    options={{
      grid: true,
      x: { label: "Poids (lb)" },
      y: { label: "Puissance (hp)" },
      marks: [
        Plot.dot(filtered, {
          x: "weight (lb)",
          y: "power (hp)",
          fill: "steelblue",
          fillOpacity: 0.7,
          r: 4,
        }),
      ],
    }}
  />
  <p><a class="text-sky-700 underline" href="/cars/rendu-statique">← Retour</a></p>
</LayoutMenu>
